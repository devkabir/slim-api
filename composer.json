{
    "name": "app/slim-todo-api",
    "description": "Simple Todo List CRUD API with Slim 4, Memcached, and MySQL",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "doctrine/dbal": "^4.2",
        "monolog/monolog": "^3.11",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/cache": "^7.2",
        "symfony/rate-limiter": "^7.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "ext-memcached": "Required to enable Memcached caching layer"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "start": "php -S 127.0.0.1:8000 -t public"
    },
    "require-dev": {
        "symfony/var-dumper": "^8.1"
    }
}
