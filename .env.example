APP_ENV=development
APP_DEBUG=true
HEALTH_CHECK_SECRET=your-secret-health-key-here

# Security & HTTPS Configuration
FORCE_HTTPS=false
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
REFERRER_POLICY=strict-origin-when-cross-origin
CONTENT_SECURITY_POLICY="default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"

# Database Configuration (Least-privileged dedicated user)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=slim_todo_db
DB_USER=todo_app
DB_PASS=your-database-password

# Optional Database SSL / TLS Encrypted Connection Options (for network/remote database)
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_CIPHER=
DB_SSL_VERIFY_SERVER_CERT=false

# Memcached Configuration (Bind to 127.0.0.1 / private VPC interface only)
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_TTL=3600
# Optional SASL Authentication credentials
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
